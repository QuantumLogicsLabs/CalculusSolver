{
  "learning_rate": 0.0001,
  "warmup_steps": 1000,
  "batch_size": 32,
  "max_steps": 3500,
  "hidden_dim": 256,
  "max_len": 80,
  "epochs": 15,
  "grad_clip_max_norm": 1.0,
  "early_stopping": {
    "enabled": true,
    "patience": 3,
    "min_delta": 0.0001
  },
  "validation_logging": true,
  "scheduled_sampling": {
    "enabled": true,
    "start_prob": 0.0,
    "end_prob": 0.45,
    "schedule": "linear"
  },
  "proxy_eval_examples": 15,
  "lr_decay": {
    "type": "cosine",
    "min_lr_ratio": 0.1
  }
}